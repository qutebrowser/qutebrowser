# qutebrowser AI feature — environment variable configuration
# Copy to .env (which is gitignored) and adjust as needed.

# OpenAI-compatible endpoint (Ollama, LM Studio, OpenAI, etc.)
# AI_BASE_URL=http://localhost:11434/v1

# Model name sent in the request
# AI_MODEL=gemma:2b

# API key (only needed for cloud providers; local Ollama doesn't require it)
# AI_API_KEY=

# Number of candidate commands to retrieve for the model
# AI_TOP_K=8

# Skip confirmation prompt (off by default for safety)
# AI_AUTO_CONFIRM=false
